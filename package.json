{
  "name": "my-travel",
  "version": "1.0.0",
  "description": "Flights, travel diary and membership wallet with live gate, lounge, visa, strike and ground-transport briefings.",
  "main": "server/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test test/*.test.js test/*.test.ts",
    "build:data": "node scripts/build-data.mjs",
    "build:artifact": "node scripts/build-artifact.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dskiad/My-travel-.git"
  },
  "bugs": {
    "url": "https://github.com/dskiad/My-travel-/issues"
  },
  "homepage": "https://github.com/dskiad/My-travel-#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "d3-geo": "^3.1.1",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "jsbarcode": "^3.12.3",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
